# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored so your real IP stays out of this public repo.

region             = "ap-northeast-1"
cluster_name       = "tituseff-playground"
kubernetes_version = "1.36"
node_pools         = ["general-purpose", "system"]

# Your workstation's public IP, so only you can reach the cluster's API endpoint.
# Find it with:  curl https://checkip.amazonaws.com
public_access_cidrs = ["YOUR_PUBLIC_IP/32"]

# --- Module toggles ---
# Each root module can be spawned (true) or destroyed (false) with a plain `terraform apply`.
# enable_eks and enable_client_egress both require enable_vpc = true.
# enable_vpc           = false # dedicated VPC; disable LAST (after eks + client egress are gone)
# enable_eks           = false # EKS Auto Mode cluster + LBC Pod Identity; delete Ingress/LoadBalancer Services before disabling
# enable_client_egress = false # per-client static egress NAT/EIPs; disabling releases the EIPs (new IPs on re-enable)
