# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored so your real IP stays out of this public repo.

region             = "ap-northeast-1"
cluster_name       = "tituseff-playground"
kubernetes_version = "1.36"
node_pools         = ["general-purpose", "system"]

# Your workstation's public IP, so only you can reach the cluster's API endpoint.
# Find it with:  curl https://checkip.amazonaws.com
public_access_cidrs = ["YOUR_PUBLIC_IP/32"]

# --- Module toggles ---
# Each root module can be spawned (true) or destroyed (false) with a plain `terraform apply`.
# enable_eks and enable_client_egress both require enable_vpc = true.
# enable_vpc           = true  # dedicated VPC; disable LAST (after eks + client egress are gone)
# enable_eks           = true  # EKS Auto Mode cluster + LBC Pod Identity; delete Ingress/LoadBalancer Services before disabling
# enable_client_egress = false # per-client static egress NAT/EIPs; disabling releases the EIPs (new IPs on re-enable)
# enable_route53_domain = true  # WARNING: true BUYS domain_name via Route 53 Domains (non-refundable); see README "Domain registration"
# enable_nifi_ingress   = true  # ACM cert for nifi_domain_name (stage 1); needs the domain_name hosted zone to exist
# enable_nifi_dns       = true  # alias A record -> NiFi ALB (stage 2); requires enable_nifi_ingress + nifi_alb_name. Set false BEFORE deleting the Ingress

# --- Route 53 domain registration (only used when enable_route53_domain = true) ---
# domain_name              = "titusefferian.dev"
# domain_duration_in_years = 1
# domain_auto_renew        = true
#
# Registrant/admin/tech/billing contact (WHOIS privacy is enabled). PLACEHOLDERS ONLY —
# put your real details in terraform.tfvars (gitignored), never in this file.
# The email must be verified within 15 days of registration or the domain is suspended.
# domain_contact = {
#   contact_type   = "PERSON"          # PERSON | COMPANY | ASSOCIATION | PUBLIC_BODY | RESELLER
#   first_name     = "Jane"
#   last_name      = "Doe"
#   email          = "you@example.com"
#   phone_number   = "+81.000000000"   # "+<country code>.<number>"
#   address_line_1 = "1-1-1 Example"
#   city           = "Chiyoda-ku"
#   state          = "Tokyo"
#   zip_code       = "100-0000"
#   country_code   = "JP"              # ISO 3166-1 alpha-2
# }
#
# Optional DNS records in the adopted zone (terraform-aws-modules/route53 `records` input).
# .dev is HSTS-preloaded: anything you serve must be HTTPS.
# domain_records = {
#   apex_txt = {
#     full_name = "titusefferian.dev"
#     type      = "TXT"
#     ttl       = 300
#     records   = ["\"example-verification=placeholder\""]
#   }
# }

# --- NiFi ingress (only used when enable_nifi_ingress = true; see README "NiFi ingress") ---
# The certificate and alias record go into the domain_name hosted zone.
# nifi_domain_name = "nifi.titusefferian.dev"
# nifi_alb_name    = "tituseff-playground-nifi" # must match eks-infra nifi/values.yaml ingress.loadBalancerName
